# 从 https://platform.openai.com/api-keys 创建；第三方中转填对方提供的 Key，勿提交到 git
OPENAI_API_KEY=sk-...

# 官方默认 https://api.openai.com/v1（可不写）
# 第三方 OpenAI 兼容网关：必须带 /v1（只填根域名会返回 HTML 前台页）
OPENAI_BASE_URL=https://z.apiyihe.org/v1

# 可选，默认 gpt-4o-mini（文案识图）
# OPENAI_MODEL=gpt-4o
# 手绘等大 JSON 输出上限，默认按张数自动加大（约 6k+3.5k/张）
# OPENAI_MAX_TOKENS=16384

# 手绘模板：图像编辑模型（需支持 POST /v1/images/edits，官方或兼容网关）
# OPENAI_IMAGE_MODEL=gpt-image-1
# 手绘是否调用 gpt-image-1 图像编辑（默认 false，仅一次 mini 识图+JSON，更快）
# HAND_DRAWN_USE_IMAGE_API=false
# 图像编辑失败时，是否再调 mini 生成 SVG 轮廓坐标（默认 false，由前端兜底）
# HAND_DRAWN_OVERLAY_VISION=false

# 调用模型最长等待秒数，默认 360
# OPENAI_TIMEOUT=360

# 黑板手账本地抠图（BiRefNet，首次使用自动下载模型）
# DAYFRAME_CUTOUT_ENABLED=true
# 默认完整版约 973 MB；低资源环境可改 birefnet-general-lite（约 224 MB）
# DAYFRAME_CUTOUT_MODEL=birefnet-general
# 人物、合照或检测到人脸时自动使用人像模型（约 973 MB）
# DAYFRAME_CUTOUT_PORTRAIT_MODEL=birefnet-portrait
# DAYFRAME_CUTOUT_MODEL_DIR=.models/rembg
# DAYFRAME_MAX_CUTOUTS=3
# DAYFRAME_CUTOUT_MAX_SIDE=2048
# DAYFRAME_CUTOUT_THREADS=2
# 仅用于计算裁剪边界，降低可保留手指、发丝等低透明区域
# DAYFRAME_CUTOUT_BOUNDS_THRESHOLD=8
# 填补主体内部孔洞的最大面积比例；轮廓闭合半径默认按图片尺寸计算
# DAYFRAME_CUTOUT_MAX_HOLE_RATIO=0.001
# DAYFRAME_CUTOUT_CLOSING_RADIUS=6
